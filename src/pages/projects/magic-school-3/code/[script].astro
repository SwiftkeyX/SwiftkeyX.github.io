---
// One page per script: the Magic School 3 and Magic School 4 versions side by side, nothing else.
// No site header or footer: the two files fill the screen, and each one scrolls on its own.
import '../../../../styles/global.css';
import { site } from '../../../../site';

export function getStaticPaths() {
  return [
    { params: { script: 'skill' }, props: { file: 'skill', title: 'LumenSkill.cs' } },
    { params: { script: 'hero-skill' }, props: { file: 'hero-skill', title: 'HeroSkill.cs' } },
    { params: { script: 'skill-definition' }, props: { file: 'skill-definition', title: 'SkillDefinition.cs' } },
  ];
}

const { file, title } = Astro.props;
const pages = import.meta.glob('../../../../extra/ms3-code/*.md', { eager: true });
const { Content } = pages[`../../../../extra/ms3-code/${file}.md`];
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · Magic School 3 vs 4 · ${site.name}`}</title>
    <meta name="description" content={`${title}: the Magic School 3 version next to the Magic School 4 version.`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="code-only">
    <main class="prose">
      <Content />
    </main>
  </body>
</html>
