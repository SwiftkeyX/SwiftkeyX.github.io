---
// The full "How a skill is put together" walkthrough for Magic School 4, kept off the main project page.
import Base from '../../../layouts/Base.astro';
import { Content } from '../../../extra/ms4-skill-system.md';

const base = import.meta.env.BASE_URL;
---

<Base title="Magic School 4 · How a skill is put together" description="Magic School 4's skill system, followed through one hero's skill: the skill class, its flow, its parts and its hooks.">
  <a class="back" href={`${base}projects/magic-school-4/`}>← Magic School 4</a>

  <section class="proj-hero">
    <p class="kind">Magic School 4 · Skill system</p>
    <h1>How a skill is put together</h1>
  </section>

  <article class="prose">
    <Content />
  </article>

  <p><a href={`${base}projects/magic-school-4/#how-a-skill-is-put-together`}>← Back to Magic School 4</a></p>

  <!-- a clicked hero GIF opens here, big; click anywhere or press Esc to close -->
  <dialog class="lightbox" aria-label="Enlarged clip">
    <img alt="" />
    <p></p>
  </dialog>

  <script>
    const box = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
    const big = box.querySelector('img')!;
    const caption = box.querySelector('p')!;

    document.querySelectorAll<HTMLImageElement>('.hero-cell img').forEach((gif) => {
      gif.addEventListener('click', () => {
        big.src = gif.src;
        big.alt = gif.alt;
        caption.textContent = gif.alt;
        box.showModal();
      });
    });

    box.addEventListener('click', () => box.close());
  </script>
</Base>
